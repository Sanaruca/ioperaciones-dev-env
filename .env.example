# PostgreSQL (solo desarrollo local)
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=dev
DATABASE_URL=postgresql://dev:dev@localhost:5432/dev

# Claves de proveedores para OpenCode (opcional).
# También puedes ejecutar `opencode auth login` dentro del contenedor;
# las credenciales se guardan en el volumen iop-opencode-data.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
